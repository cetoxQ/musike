<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permissions -->

    <!-- Android TV: no touchscreen, leanback UI, network only -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <!-- Android Auto, parked: the app itself on the car's screen (see appCategory below). Optional, so it installs on phones. -->
    <uses-feature android:name="android.hardware.type.automotive" android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Lets Android Auto open the app in the background (granted by the user in Settings > Android Auto). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Updates: the APK of a newer release, downloaded by the app, goes to Android's installer (MusikeDevicePlugin). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Musike Video (mobile/android/carvideo), the separate app for the video's picture on the car's screen, asks this
         one what's playing (NowPlayingProvider). Only apps signed with the same key get the permission. -->
    <permission android:name="${applicationId}.permission.NOW_PLAYING" android:protectionLevel="signature" />
    <queries>
        <package android:name="${applicationId}.video" />
    </queries>

    <!-- appCategory/isGame: Android Auto (phone on Android 15 or newer) opens only games on the car's screen, and only
         while parked: that's how videos can be watched in the car. Android Auto covers the app as soon as the car moves;
         the sound plays on, through the car's media player (PlaybackService).
         usesCleartextTraffic: a Musike server on the home network is often plain http (the app warns about it).
         Backups leave out the session token: res/xml/backup_rules.xml and data_extraction_rules.xml. -->
    <application
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/banner"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:appCategory="game"
        android:isGame="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- Android TV launchers only show apps with this category -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <!-- Android Auto's parked apps (see appCategory) -->
                <category android:name="android.intent.category.CAR_LAUNCHER" />
            </intent-filter>

            <!-- Share > Musike, from YouTube, YouTube Music or anywhere else: MainActivity turns the text into a link. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- YouTube links opened with Musike: Settings > Apps > Musike > Open by default > Add links. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="youtube.com" />
                <data android:host="www.youtube.com" />
                <data android:host="m.youtube.com" />
                <data android:host="music.youtube.com" />
                <data android:pathPrefix="/watch" />
                <data android:pathPrefix="/shorts/" />
                <data android:pathPrefix="/playlist" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="youtu.be" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Keeps the music going with the screen off; shows the media notification and lock screen controls.
             Exported for Android Auto, which browses the library through it (see PlaybackService). -->
        <service
            android:name=".PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- What's playing, for Musike Video (see the permission above). -->
        <provider
            android:name=".NowPlayingProvider"
            android:authorities="${applicationId}.nowplaying"
            android:exported="true" />

        <!-- Android Auto lists Musike among the car's media apps. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
    </application>

</manifest>
